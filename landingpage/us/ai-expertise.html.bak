  <!-- intl-tel-input JS (local) -->
  <script src="../../../assets/iti/js/intlTelInput.min.js"></script>
  <script>
    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // Initialize intl-tel-input on the phone field
    const phoneInput = document.getElementById('lp-phone-number');
    const iti = window.intlTelInput(phoneInput, {
      initialCountry: 'us',
      separateDialCode: true,
      nationalMode: true,
      utilsScript: '../../../assets/iti/js/utils.js',
    });

    // Form submission handler
    const form = document.getElementById('lpContactForm');
    const formContent = document.getElementById('lp-form-content');
    const successMsg = document.getElementById('lp-success-msg');
    const submitBtn = document.getElementById('lp-submit-btn');

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      // Basic validation for non-phone required fields
      const required = form.querySelectorAll('[required]');
      let valid = true;

      required.forEach(field => {
        if (field.id === 'lp-phone-number') return; // handled by iti capture listener
        field.style.borderColor = '';
        if (!field.value.trim()) {
          field.style.borderColor = '#ef4444';
          valid = false;
        }
      });

      // Email format check
      const emailField = document.getElementById('lp-work-email');
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (emailField.value && !emailRegex.test(emailField.value)) {
        emailField.style.borderColor = '#ef4444';
        valid = false;
      }

      // Phone check via local iti validation (if it exists)
      const phoneEl = document.getElementById('lp-phone-number');
      phoneEl.classList.remove('error-border');
      if (typeof iti !== 'undefined') {
        if (!iti.isValidNumber()) {
          phoneEl.classList.add('error-border');
          valid = false;
        }
      } else if (!phoneEl.value.trim()) {
        phoneEl.classList.add('error-border');
        valid = false;
      }

      if (!valid) return;

      // Show loading state
      submitBtn.textContent = 'Sending…';
      submitBtn.disabled = true;

      // Package data for Web3Forms submission
      const formData = new FormData(form);
      
      // Ensure phone field captures the formatted input with dial code
      if (typeof iti !== 'undefined') {
        formData.set('phone', iti.getNumber());
      }

      // POST to Web3Forms endpoint
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          formContent.style.display = 'none';
          successMsg.style.display = 'block';
        } else {
          alert('Submission error. Please try again.');
          submitBtn.textContent = 'Get Matched with AI Experts →';
          submitBtn.disabled = false;
        }
      })
      .catch(error => {
        console.error('Error submitting form:', error);
        alert('Network error. Please try again.');
        submitBtn.textContent = 'Get Matched with AI Experts →';
        submitBtn.disabled = false;
      });
    });

    // Reset error highlight on input
    form.querySelectorAll('input, select, textarea').forEach(field => {
      field.addEventListener('input', function () {
        this.style.borderColor = '';
        this.classList.remove('error-border');
      });
    });

    // Intersection observer for card entrance animation
    const cards = document.querySelectorAll('.lp-benefit-card, .lp-skill-item');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'translateY(0)';
          }, i * 60);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    cards.forEach(card => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(24px)';
      card.style.transition = 'opacity 0.5s ease, transform 0.5s ease, box-shadow 0.25s, border-color 0.25s';
      observer.observe(card);
    });
  </script>



</body>

</html>
