            <h2 class="lp-form-title">Connect with an AI Talent Expert</h2>
            <p class="lp-form-subtitle">Tell us your hiring needs and we'll match you with the right experts—fast.</p>

            <form id="lpContactForm" action="https://api.web3forms.com/submit" method="POST" novalidate>
              <!-- 🔑 Access Key (same as contact.html) -->
              <input type="hidden" name="access_key" value="ed4ac44d-4b09-4f2c-ad7b-ff8296fdd48b" />
              <!-- 📩 Email Settings -->
              <input type="hidden" name="subject" value="New AI Talent Request - Landing Page" />
              <input type="hidden" name="from_name" value="People Prime AI Landing Page" />
              <input type="hidden" name="email_template" value="table" />

              <div class="lp-form-group">
                <label for="lp-work-email">Business Email *</label>
                <input type="email" id="lp-work-email" name="email" placeholder="you@company.com" required />
              </div>

              <div class="lp-form-group">
                <label for="lp-full-name">Full Name *</label>
                <input type="text" id="lp-full-name" name="fullName" placeholder="John Smith" required />
              </div>

              <div class="lp-form-group">
                <label for="lp-company-name">Company Name *</label>
                <input type="text" id="lp-company-name" name="companyName" placeholder="e.g. Acme Corp" required />
              </div>

              <div class="lp-form-group">
                <label for="lp-phone-number">Phone Number *</label>
                <input type="tel" id="lp-phone-number" name="phone" placeholder="(555) 000-0000" autocomplete="tel" />
              </div>

              <div class="lp-form-group">
                <label for="lp-job-title">Job Title *</label>
                <input type="text" id="lp-job-title" name="jobTitle" placeholder="e.g. VP of Engineering, CTO" required />
              </div>

              <button type="submit" class="lp-submit-btn" id="lp-submit-btn">
                Get Matched with AI Experts →
              </button>

              <p class="lp-form-disclaimer">
                By submitting, you agree to our
                <a href="../../privacy.html" target="_blank">Privacy Policy</a>.
                We'll never share your info.
              </p>
            </form>
          </div>

          <!-- Success State -->
